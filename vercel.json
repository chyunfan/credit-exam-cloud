{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/credit-exam-cloud/:path*",
      "destination": "/:path*"
    }
  ],
  "functions": {
    "api/register.js": { "memory": 256, "maxDuration": 10 },
    "api/login.js": { "memory": 256, "maxDuration": 10 }
  }
}
